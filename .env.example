# SQLite local, com arquivo persistente na raiz do projeto.
DATABASE_URL=sqlite:///./controle_estoque.db
# Para usar PostgreSQL local, substitua a URL acima pela conexão do seu banco.
# DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/controle_estoque
# No Neon, use a URL direta de Connect com o prefixo postgresql+psycopg://.
# Preserve os parâmetros sslmode=require e channel_binding=require da URL.

# Gere uma chave local com: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA

# Origem adicional do frontend no navegador. Localhost já é aceito.
# ENDERECO_DO_APP=https://seu-app.onrender.com
